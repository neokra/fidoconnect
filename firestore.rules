rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && (
          (request.auth.token.email != null && (
            request.auth.token.email == "thecard.primary@gmail.com"
            || request.auth.token.email.lower() == "thecard.primary@gmail.com"
          ))
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
        );
    }

    // =========================================================================
    // 1. Users Collection
    //    - Authenticated users can read any profile (admin panel, project
    //      owner lookup, freelancer card display).
    //    - Owners create / update their own document; admin can update any doc
    //      (used by verifyMembershipPayment -> updateMembership -> updateUser).
    //    - Admin-only delete.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
                    && request.resource.data.get('uid', '') == userId
                    && (request.resource.data.get('role', null) != 'admin' || isAdmin());

      allow update: if isAdmin()
                    || (isOwner(userId)
                        && (request.resource.data.get('role', null) != 'admin' || isAdmin()));

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Invite Codes Collection
    //    - Authenticated users can read & validate codes (auth.html sign-up).
    //    - Authenticated users can claim (update) a code during registration.
    //    - Only admin can create or delete codes.
    // =========================================================================
    match /inviteCodes/{inviteCodeId} {
      allow read:          if isAuthenticated() || isAdmin();
      allow update:        if isAuthenticated();
      allow create, delete: if isAdmin();
    }

    // =========================================================================
    // 3. Public Projects Collection
    //    - Anyone can read public summaries (home page, find-work, share links).
    //    - Any authenticated user can write (synced on project submit / update).
    // =========================================================================
    match /publicProjects/{projectId} {
      allow read:  if true;
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // 4. Full Projects Collection
    //    - Any authenticated user can read full project details (project-details,
    //      admin panel, freelancer skill matching).
    //    - Any authenticated user can create a project (clients via post-work).
    //    - Only the project owner (clientId) or admin can update.
    //    - Only admin can delete.
    // =========================================================================
    match /projects/{projectId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
                    && (resource.data.get('clientId', '') == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. Counters Collection (Atomic project ID sequence FC-XXX)
    //    - Any authenticated user can read/write (needed to generate next ID).
    // =========================================================================
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 6. Applications Collection
    //    - Any authenticated user can read (filtered in JS layer per role).
    //    - Freelancers can create an application only for their own UID.
    //      Uses deterministic ID (projectId_freelancerId) via setDoc, so
    //      this rule covers both initial create and re-submission after withdrawal.
    //    - Freelancers can update their own application (withdraw/edit).
    //      Admin can update any application (status, assignment, etc.).
    //    - Only admin can delete.
    // =========================================================================
    match /applications/{applicationId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.get('freelancerId', '') == request.auth.uid;

      allow update: if isAuthenticated()
                    && (resource.data.get('freelancerId', '') == request.auth.uid || isAdmin());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. Membership Plans Collection (Database-driven plans)
    //    - Anyone can read published membership plans.
    //    - Only admin can create, update, or delete membership plans.
    // =========================================================================
    match /membershipPlans/{planId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7b. Memberships Collection (Legacy compatibility)
    //    - Membership state is primarily stored inside the user document.
    //      This collection is kept for backward compatibility.
    //    - Owner or admin can create / update records.
    //    - Only admin can delete.
    // =========================================================================
    match /memberships/{membershipId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
                            && (request.resource.data.get('freelancerId', '') == request.auth.uid
                                || isAdmin());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. Payments Collection
    //    - Authenticated users can read payments (user status, history, duplicate
    //      UTR check, and admin verification dashboard).
    //    - Authenticated users can submit (create) a payment record for their own
    //      UID with a valid Transaction ID / UPI Reference Number (UTR).
    //    - Enforces UTR length (minimum 6 chars), string type, positive amount,
    //      and initial "pending" status on user creation.
    //    - Only admin can update (verify/reject) or delete payment records.
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && (
                      (
                        (request.resource.data.get('userId', '') == request.auth.uid
                         || request.resource.data.get('freelancerId', '') == request.auth.uid)
                        && request.resource.data.get('transactionId', '') is string
                        && request.resource.data.get('transactionId', '').size() >= 6
                        && request.resource.data.get('amount', 0) is number
                        && request.resource.data.get('amount', 0) > 0
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && request.resource.data.get('type', 'membership') == 'membership'
                      )
                      || isAdmin()
                    );

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. Reviews Collection
    //    - Anyone can read reviews (public credibility / trust signals).
    //    - Any authenticated user can create or update (reviewer check in JS).
    //    - Only admin can delete.
    // =========================================================================
    match /reviews/{reviewId} {
      allow read:           if true;
      allow create, update: if isAuthenticated();
      allow delete:         if isAdmin();
    }

    // =========================================================================
    // 10. Messages Collection
    //     - Only sender, recipient, or admin can read a message.
    //     - Any authenticated user can create where senderId == their UID.
    //     - Only admin can update or delete messages.
    // =========================================================================
    match /messages/{messageId} {
      allow read: if isAuthenticated()
                  && (resource.data.get('senderId', '') == request.auth.uid
                      || resource.data.get('recipientId', '') == request.auth.uid
                      || isAdmin());

      allow create: if isAuthenticated()
                    && request.resource.data.get('senderId', '') == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. Settings Collection
    //     - Anyone can read site settings (UPI config, agency name, etc.).
    //     - Only admin can write settings.
    // =========================================================================
    match /settings/{settingId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

  }
}

