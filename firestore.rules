rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "thecard.primary@gmail.com";
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      // Authenticated users can read profile data; Admin can read all
      allow read: if isAuthenticated();
      
      // Creating a new user profile for own UID
      allow create: if isOwner(userId)
                    && request.resource.data.get('uid', '') == userId
                    && (request.resource.data.get('role', null) != 'admin' || isAdmin());

      // Updating a user profile: owners can update their own document, admins can update any
      allow update: if isAdmin() || (
                      isOwner(userId)
                      && (request.resource.data.get('role', null) != 'admin' || isAdmin())
                    );
      
      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // --- 2. Invite Codes Collection ---
    match /inviteCodes/{inviteCodeId} {
      // Authenticated users can read and validate invite codes
      allow read: if isAuthenticated() || isAdmin();

      // Authenticated users can claim an active invite code
      allow update: if isAuthenticated();

      // Only admin can create or delete invite codes
      allow create, delete: if isAdmin();
    }

    // --- 3. Public Projects Collection (Public summaries for Find Work & Home) ---
    match /publicProjects/{projectId} {
      // Anyone can browse public project summaries
      allow read: if true;
      
      // Synchronized on project creation/publish by client owner or admin
      allow write: if isAuthenticated() || isAdmin();
    }

    // --- 4. Protected Projects Collection (Full project requirements) ---
    match /projects/{projectId} {
      // Authenticated users can view projects; admin can read all
      allow read: if isAuthenticated() || isAdmin();
      
      // Authenticated users (clients, freelancers, admins) can submit/create projects
      allow create: if isAuthenticated() || isAdmin();
      
      // Project owner or admin can update status and details
      allow update: if isAuthenticated() && (
                      resource.data.get('clientId', '') == request.auth.uid ||
                      isAdmin()
                    );
      
      // Only Admin can delete/cancel projects
      allow delete: if isAdmin();
    }

    // --- 5. Counters Collection (Atomic Project ID sequence) ---
    match /counters/{counterId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // --- 6. Applications Collection ---
    match /applications/{applicationId} {
      // Authenticated users can read applications
      allow read: if isAuthenticated();
      
      // Authenticated users can submit applications for their own UID
      allow create: if isAuthenticated()
                    && request.resource.data.get('freelancerId', '') == request.auth.uid;
      
      // Freelancers can update their own proposal/withdrawal; Admin can update status/assignment
      allow update: if isAuthenticated()
                    && (request.resource.data.get('freelancerId', '') == request.auth.uid
                        || resource.data.get('freelancerId', '') == request.auth.uid
                        || isAdmin());
      
      // Only admin can delete applications
      allow delete: if isAdmin();
    }

    // --- 7. Memberships Collection ---
    match /memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.get('freelancerId', '') == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- 8. Payments Collection ---
    match /payments/{paymentId} {
      // Authenticated users can read payment history, admin has full access
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.get('freelancerId', '') == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- 9. Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- 10. Messages Collection ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.get('senderId', '') == request.auth.uid || 
        resource.data.get('recipientId', '') == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.get('senderId', '') == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- 11. Settings Collection ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
