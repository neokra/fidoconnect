rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'thecard.primary@gmail.com';
    }

    function isUserDocument(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isVerifiedFreelancer() {
      return isAuthenticated() && isUserDocument(request.auth.uid) && getUserData().inviteVerified == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Owner can read their own profile; Admin can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow registration/Google sign-in, but FORBID setting role == 'admin' unless administrator email
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    (request.resource.data.role != 'admin' || isAdmin());
      
      // Normal user can update non-privileged fields (cannot elevate role to 'admin' or alter membership status unless admin)
      allow update: if (isOwner(userId) && 
                        (request.resource.data.role == resource.data.role || (resource.data.role == null && request.resource.data.role != 'admin')) &&
                        (request.resource.data.membershipStatus == resource.data.membershipStatus || resource.data.membershipStatus == null)) || 
                       isAdmin();
      
      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // --- Invite Codes Collection ---
    match /inviteCodes/{inviteCodeId} {
      // Admin has full control
      allow read, write: if isAdmin();

      // Non-admin can only get single code for verification (cannot list/browse entire collection)
      allow get: if true;

      // Allow claiming an invite code when registering/verifying
      allow update: if (isAuthenticated() && 
                        resource.data.status == 'active' && 
                        request.resource.data.status == 'used' && 
                        request.resource.data.usedBy == request.auth.uid) || 
                       isAdmin();
    }

    // --- Projects Collection ---
    match /projects/{projectId} {
      // Anyone can read published projects with public visibility (summary view on Find Work)
      // Clients can read their own submitted projects; Assigned freelancers and Admins can read
      allow read: if resource.data.status == 'Published' || 
                     (isAuthenticated() && (resource.data.clientId == request.auth.uid || 
                                           resource.data.assignedFreelancerId == request.auth.uid || 
                                           isAdmin()));
      
      // Allow project creation by clients / submission form
      allow create: if true;
      
      // Only Admin or project owner (for non-status fields) can update project
      allow update: if (isAuthenticated() && resource.data.clientId == request.auth.uid && 
                        request.resource.data.status == resource.data.status &&
                        request.resource.data.assignedFreelancerId == resource.data.assignedFreelancerId) || 
                       isAdmin();
      
      // Only Admin can delete/cancel projects
      allow delete: if isAdmin();
    }

    // --- Counters Collection (Atomic Project ID sequence) ---
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // --- Applications Collection ---
    match /applications/{applicationId} {
      // Freelancers can read their own applications; admins can read all
      allow read: if (isAuthenticated() && resource.data.freelancerId == request.auth.uid) || isAdmin();
      
      // Only verified freelancers (or admin) can submit proposals
      allow create: if isAuthenticated() && 
                       request.resource.data.freelancerId == request.auth.uid && 
                       (isVerifiedFreelancer() || isAdmin());
      
      // Freelancer can update draft notes; Admin can update status (Shortlisted, Selected, Rejected)
      allow update: if (isAuthenticated() && resource.data.freelancerId == request.auth.uid &&
                        request.resource.data.status == resource.data.status) || 
                       isAdmin();
      
      // Only admin can delete applications
      allow delete: if isAdmin();
    }

    // --- Memberships Collection ---
    match /memberships/{membershipId} {
      allow read: if (isAuthenticated() && resource.data.freelancerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // --- Messages Collection ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.recipientId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
