rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "thecard.primary@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isVerifiedFreelancer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('inviteVerified', false) == true;
    }

    function hasValidInviteClaim(inviteCodeId) {
      return inviteCodeId != null
        && exists(/databases/$(database)/documents/inviteCodes/$(inviteCodeId))
        && get(/databases/$(database)/documents/inviteCodes/$(inviteCodeId)).data.get('status', '') == 'used'
        && get(/databases/$(database)/documents/inviteCodes/$(inviteCodeId)).data.get('usedBy', '') == request.auth.uid;
    }

    // --- 1. Users Collection ---
    match /users/{userId} {
      // Owner can read their own profile; Admin can read all profiles
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // A new profile must belong to the authenticated account. Non-admin users
      // begin unverified and cannot create themselves as an administrator.
      allow create: if isOwner(userId)
                    && request.resource.data.get('uid', '') == userId
                    && request.resource.data.get('email', '') == request.auth.token.email
                    && (request.resource.data.get('role', null) != 'admin' || isAdmin())
                    && (request.resource.data.get('role', null) != 'freelancer'
                        || (request.resource.data.get('inviteVerified', false) == true
                            && hasValidInviteClaim(request.resource.data.get('inviteCodeId', null))))
                    && (request.resource.data.get('inviteVerified', false) == false
                        || hasValidInviteClaim(request.resource.data.get('inviteCodeId', null)));

      // Owners may edit ordinary profile fields. Privileged fields may only be
      // set once while completing a profile, and freelancer access requires a
      // previously claimed invite code that belongs to that account.
      allow update: if isAdmin() || (
                      isOwner(userId)
                      && request.resource.data.get('uid', '') == resource.data.get('uid', '')
                      && request.resource.data.get('email', '') == resource.data.get('email', '')
                      && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
                      && request.resource.data.get('role', null) != 'admin'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'name', 'photoURL', 'phone', 'businessName', 'skills',
                           'portfolio', 'role', 'accountType', 'inviteVerified',
                           'inviteCodeId', 'membershipStatus', 'membershipPlan', 'updatedAt',
                           'categories', 'subcategories', 'bio', 'customSkills', 'profileCompleted', 'userId'
                         ])
                      && (
                        // Routine profile edits cannot alter access or membership.
                        (request.resource.data.get('role', null) == resource.data.get('role', null)
                         && request.resource.data.get('accountType', null) == resource.data.get('accountType', null)
                         && request.resource.data.get('inviteVerified', false) == resource.data.get('inviteVerified', false)
                         && request.resource.data.get('inviteCodeId', null) == resource.data.get('inviteCodeId', null)
                         && request.resource.data.get('membershipStatus', null) == resource.data.get('membershipStatus', null)
                         && request.resource.data.get('membershipPlan', null) == resource.data.get('membershipPlan', null))
                        // Initial completion as a client.
                        || (resource.data.get('role', null) == null
                            && request.resource.data.get('role', null) == 'client'
                            && request.resource.data.get('accountType', null) == 'client'
                            && request.resource.data.get('inviteVerified', false) == false
                            && request.resource.data.get('inviteCodeId', null) == null
                            && request.resource.data.get('membershipStatus', null) == resource.data.get('membershipStatus', null)
                            && request.resource.data.get('membershipPlan', null) == resource.data.get('membershipPlan', null))
                        // Initial completion as a freelancer after claiming an invite.
                        || ((resource.data.get('role', null) == null || resource.data.get('role', null) == 'client')
                            && request.resource.data.get('role', null) == 'freelancer'
                            && request.resource.data.get('accountType', null) == 'freelancer'
                            && request.resource.data.get('inviteVerified', false) == true
                            && hasValidInviteClaim(request.resource.data.get('inviteCodeId', null))
                            && request.resource.data.get('membershipStatus', null) == 'inactive'
                            && request.resource.data.get('membershipPlan', null) == 'None')
                      )
                    );
      
      // Only admin can delete users
      allow delete: if isAdmin();
    }

    // --- 2. Invite Codes Collection ---
    match /inviteCodes/{inviteCodeId} {
      // Admin has full control
      allow read, write: if isAdmin();

      // Authenticated users can get a specific document if they know the code ID (e.g. for validation/claim), but CANNOT list/browse all
      allow get: if isAuthenticated() && (resource.data.get('status', '') == 'active' || resource.data.get('usedBy', '') == request.auth.uid || isAdmin());

      // Authenticated users can claim an active invite code for their own UID
      allow update: if (isAuthenticated()
                        && resource.data.get('status', '') == 'active'
                        && request.resource.data.get('status', '') == 'used'
                        && request.resource.data.get('usedBy', '') == request.auth.uid
                        && request.resource.data.get('usedByEmail', '') == request.auth.token.email
                        && request.resource.data.get('usedAt', '') is string
                        && request.resource.data.get('code', '') == resource.data.get('code', '')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'usedBy', 'usedByEmail', 'usedAt'
                           ]))
                       || isAdmin();
    }

    // --- 3. Public Projects Collection (Safe representation for Find Work) ---
    match /publicProjects/{projectId} {
      // All authenticated users can read public project summaries for Find Work browsing
      allow read: if isAuthenticated();
      
      // Synchronized on project creation/publish by client owner or admin
      allow write: if isAuthenticated() || isAdmin();
    }

    // --- 4. Protected Projects Collection (Full confidential details) ---
    match /projects/{projectId} {
      // Protected project read: Owner/client, assigned freelancer, verified freelancer, or admin
      allow read: if (isAuthenticated() && (
                       resource.data.get('clientId', '') == request.auth.uid ||
                       resource.data.get('assignedFreelancerId', '') == request.auth.uid ||
                       isVerifiedFreelancer() ||
                       isAdmin()
                     ));
      
      // Authenticated clients can create projects
      allow create: if isAuthenticated() && request.resource.data.get('clientId', '') == request.auth.uid;
      
      // Only project owner (client) or admin can update
      allow update: if (isOwner(resource.data.get('clientId', ''))
                        && request.resource.data.get('status', '') == resource.data.get('status', '')
                        && request.resource.data.get('assignedFreelancerId', '') == resource.data.get('assignedFreelancerId', ''))
                       || isAdmin();
      
      // Only Admin can delete/cancel projects
      allow delete: if isAdmin();
    }

    // --- 5. Counters Collection (Atomic Project ID sequence) ---
    match /counters/{counterId} {
      allow read, write: if isAuthenticated() || isAdmin();
    }

    // --- 6. Applications Collection ---
    match /applications/{applicationId} {
      // Freelancers can read their own applications; admins can read all
      allow read: if (isAuthenticated() && resource.data.get('freelancerId', '') == request.auth.uid) || isAdmin();
      
      // Only verified freelancers (or admin) can submit proposals
      allow create: if isAuthenticated()
                    && request.resource.data.get('freelancerId', '') == request.auth.uid
                    && (isVerifiedFreelancer() || isAdmin());
      
      // Freelancer can update draft notes; Admin can update status (Shortlisted, Selected, Rejected)
      allow update: if (isAuthenticated()
                        && resource.data.get('freelancerId', '') == request.auth.uid
                        && request.resource.data.get('status', '') == resource.data.get('status', ''))
                       || isAdmin();
      
      // Only admin can delete applications
      allow delete: if isAdmin();
    }

    // --- 7. Memberships Collection ---
    match /memberships/{membershipId} {
      allow read: if (isAuthenticated() && resource.data.get('freelancerId', '') == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // --- 8. Payments Collection ---
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // --- 9. Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // --- 10. Messages Collection ---
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.get('senderId', '') == request.auth.uid || 
        resource.data.get('recipientId', '') == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.get('senderId', '') == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- 11. Settings Collection ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
